menu "ConvAI audio codecs"

    config CONVAI_ENABLE_OPUS
        bool "Enable Opus codec"
        default y
        help
            Include the Opus codec (vendored opus-1.6.1, fixed-point CELT).
            Disable to save flash on builds that only need PCM/G.711/ADPCM.

endmenu

menu "ConvAI transport & buffers"

    config CONVAI_WS_TASK_STACK
        int "WebSocket client task stack (bytes)"
        default 4096

    config CONVAI_TX_QUEUE_FRAMES
        int "Uplink TX queue depth (frames, 768B each)"
        default 16
        help
            Absorbs network stalls: mic frames queue here while the sender
            task drains them. Full -> oldest frame dropped (counted), never
            blocks the recorder. 16 frames = 320ms of audio.

    config CONVAI_RX_RING_KB
        int "Downlink RX jitter ring size (KB)"
        default 24
        help
            Absorbs playback/system stalls: decoded TTS PCM is buffered
            here. Full -> oldest whole frame dropped (counted).
            24KB = 1.5s @8kHz / 0.75s @16kHz PCM16.

endmenu

menu "ConvAI transport security"

    config CONVAI_WSS_CA_BUNDLE
        bool "WSS: verify with built-in CA bundle"
        default y
        help
            When the server URL uses wss://, verify the server certificate
            against the ESP-IDF built-in CA bundle (public CAs).

    config CONVAI_WSS_SKIP_CN_CHECK
        bool "WSS: skip certificate common-name check"
        default n
        help
            Accept certificates whose CN/SAN does not match the host
            (useful for self-signed certs addressed by IP).

endmenu
